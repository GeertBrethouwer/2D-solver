!======================================================================================================
!  Melt validation, case 1 (report "Coupled diffusion of temperature and concentration in a semi-infinite
!  domain with fixed and moving interfaces", Sec. 3.6, first simulation): no flow, receding ice interface.
!    k = 1/1200, Le = 10, S = 10 (Stefan number L/(c dT)), Gamma = 8, T_inf = 0, C_inf = 1
!  Theory: lambda = -0.14848457, C_w = 0.39224782, T_w = -3.13798, melt speed -da/dt = -lambda sqrt(k/t)
!  Mapping: kappa_T = 1/(re pr(1)) = k; pr(2) = Le; melt_st = 1/S; liquidus T = -Gamma C ->
!  melt_lambda = -Gamma, melt_thf = 0, melt_sigma = 0. The interface is fixed at y = 0 and the meltwater
!  velocity v = m* = -da/dt (melt_blowing) gives the interface-attached frame z' = z - a(t) of the report.
!  The semi-infinite domain is approximated by ly = 1 with the far-field values at y = ly.
!  Run:  mpirun -np 1 ../../../build/solver2d ;  then  python3 ../compare.py  (in ..)
!======================================================================================================
&grid
  nx = 4, ny = 513                     ! 1D problem: x-independent
  lx = 1.0, ly = 1.0
  grid_type = 'auto', grid_alpha = 6.0 ! -> 'tanh_bot': refined at the ice (y = 0), dy = 5.8e-5 there
                                       ! (the error of C_w is proportional to dy at the ice: it is the
                                       ! imprint of the unresolved start, when the boundary layers are
                                       ! thinner than one cell; alpha_s = 3: dy = 5.9e-4, error 1.6e-4)
/
&physics
  re = 1200., forcing = 'cpg', dpdx = 0.0   ! no flow along x
  bc_bot = 'noslip', bc_top = 'freeslip'
/
&time
  nstep = 10000000, tmax = 10.0
  dt = 1.e-6, dt_growth = 1.05, dt_max = 1.e-3, cfl = 0.5
/
&init
  init_type = 'laminar'
/
&output
  iout_log = 1, iout_stats = 0, iout_save_stats = 0, iout_restart = 10000000, iout_field = 0
/
&scalars
  nscal = 2
  pr(1) = 1.0,  sbc_bot(1) = 'D', sval_bot(1) = 0.0, sbc_top(1) = 'D', sval_top(1) = 0.0, sinit(1) = 'zero'
  pr(2) = 10.0, sbc_bot(2) = 'D', sval_bot(2) = 1.0, sbc_top(2) = 'D', sval_top(2) = 1.0, sinit(2) = 'one'
/
&melt_model
  melt = .true., melt_t = 1, melt_s = 2
  melt_st = 0.1                        ! 1/S
  melt_lambda = -8.0                   ! -Gamma
  melt_thf = 0.0, melt_sigma = 0.0
  melt_blowing = .true.
/
