!======================================================================================================
!  Production-size template for one Arrhenius node (4 x GH200): double-diffusive convection
!  (salt fingers) in a wide box, two active scalars, as examples/salt_fingers but at higher Rayleigh
!  numbers. Ra_T = 16 ri(1) re^2 Pr = 2.7e7, Ra_S = 16 |ri(2)| re^2 Sc = 6.7e7, R_rho = 1.2.
!  Run with examples/arrhenius_job.sh (4 MPI ranks). Check the resolution (fingers, scalar boundary
!  layers at Sc = 21) for your own parameters.
!======================================================================================================
&grid
  nx = 4096, ny = 513
  lx = 8.0
  ly = 2.0                             ! box height: walls at y = 0 and y = ly
  grid_type = 'tanh', grid_alpha = 2.0, fd_order = 6
/
&physics
  re = 1000., forcing = 'cpg', dpdx = 0.0
/
&time
  nstep = 2000000, tmax = 2000., wall_time_max = 85000., dt = 1.e-4, dt_max = 0.01, cfl = 0.8
/
&init
  init_type = 'noise', init_amp = 1.e-3
/
&output
  iout_log = 100, iout_stats = 20, iout_save_stats = 5000, iout_restart = 20000, iout_field = 5000
  tstats_start = 1000., timing = .true.
/
&scalars
  nscal = 2, scal_form = 'skew'
  pr(1) = 7.0,  sval_bot(1) = -1.0, sval_top(1) = 1.0, sinit(1) = 'linear'
  pr(2) = 21.0, sval_bot(2) = -1.0, sval_top(2) = 1.0, sinit(2) = 'noise'
/
&buoyancy
  gravity = 0.0, -1.0
  ri(1) =  0.24                        ! temperature: stabilising
  ri(2) = -0.2                         ! salinity: destabilising
/
