!======================================================================================================
!  Onset of Rayleigh-Benard convection between a FREE-SLIP bottom wall and a no-slip top wall,
!  driven by two active scalars (gravity -y), as examples/rayleigh_benard otherwise.
!  Ra = 16 (ri(1)+ri(2)) re^2 pr (gap d = 2h).
!  Linear theory (rigid-free): Ra_c = 1100.65 at k d = 2.682 -> lx = 2 pi d/2.682 = 4.6855,
!  with re = 100, pr = 1:  ri(1)+ri(2) = ri_c = 1100.65/16e4 = 0.00687906 (here split 70/30).
!  check.py runs (ri(1)+ri(2)) = 0.9, 1.0, 1.1 ri_c and finds the zero of the growth rate.
!======================================================================================================
&grid
  nx = 4, ny = 33                      ! one horizontal mode (linear problem)
  lx = 4.685475
  ly = 2.0                             ! box height: walls at y = 0 and y = ly
  grid_type = 'tanh', grid_alpha = 1.5, fd_order = 6
/
&physics
  re = 100., forcing = 'cpg', dpdx = 0.0     ! no mean flow
  bc_bot = 'freeslip'                  ! free-slip bottom wall
/
&time
  nstep = 10000000, tmax = 2500., fixed_dt = .true., dt = 0.1
/
&init
  init_type = 'noise', init_amp = 1.e-6
/
&output
  iout_log = 100, iout_stats = 0, iout_save_stats = 0, iout_restart = 0
  mode_log_kx = 1                      ! energy of the convection mode (column 10 of log.dat)
/
&scalars
  nscal = 2
  pr(1) = 1.0, scal_theta(1) = 0.5
  sbc_bot(1) = 'D', sval_bot(1) = 1.0, sbc_top(1) = 'D', sval_top(1) = -1.0, sinit(1) = 'linear'
  pr(2) = 1.0, scal_theta(2) = 0.5
  sbc_bot(2) = 'D', sval_bot(2) = 1.0, sbc_top(2) = 'D', sval_top(2) = -1.0, sinit(2) = 'linear'
/
&buoyancy
  gravity = 0.0, -1.0                  ! gravity towards the bottom wall
  ri(1) = 0.00481534                   ! 0.7 ri_c  (check.py overrides both)
  ri(2) = 0.00206372                   ! 0.3 ri_c
/
