!======================================================================================================
!  TEMPLATE: water below an ice layer, with temperature and salinity as active scalars.
!    y = 0  : the ice (top), no-slip, grid refined here           bc_bot = 'noslip'
!    y = ly : the bottom of the domain, free-slip, coarse grid     bc_top = 'freeslip'
!    gravity = (0, +1): y points downward, away from the ice
!  ('bot'/'top' in the input always mean y = 0 / y = ly, whatever the direction of gravity.)
!    scalar 1 = temperature: freezing temperature 0 at the ice, 1 at y = ly; ri(1) > 0 (warm water is
!               lighter, linear equation of state): warm water below cold -> convection
!    scalar 2 = salinity: fresh meltwater 0 at the ice, 1 at y = ly; ri(2) < 0 (salty water is heavier):
!               stabilising
!  Ra_T = ri(1) dT ly^3 re^2 Pr = 7e4, Ra_S = |ri(2)| dS ly^3 re^2 Sc = 4e4 (here ly = 1).
!  The parameter values are placeholders: set re, Pr, Sc, ri, the wall values and the resolution for
!  your problem. The ice-water interface is a fixed wall with prescribed scalar values: the melt rate,
!  the interface motion and the meltwater flux (Stefan / three-equation conditions) are not modelled,
!  and the equation of state is linear (no density maximum near 4 C).
!======================================================================================================
&grid
  nx = 256, ny = 129
  lx = 4.0
  ly = 1.0                             ! water depth
  grid_type = 'auto'                   ! -> 'tanh_bot': refined at the ice (y = 0) only
  grid_alpha = 3.0, fd_order = 6
/
&physics
  re = 1000., forcing = 'cpg', dpdx = 0.0   ! no imposed mean flow (for a current under the ice:
                                            ! forcing = 'cfr', ubulk = ...)
  bc_bot = 'noslip'                    ! y = 0: ice
  bc_top = 'freeslip'                  ! y = ly: free-slip
/
&time
  nstep = 1000000, tmax = 500., dt = 1.e-3, dt_max = 0.05, cfl = 0.8
/
&init
  init_type = 'noise', init_amp = 1.e-3
/
&output
  iout_log = 50, iout_stats = 10, iout_save_stats = 1000, iout_restart = 5000, iout_field = 1000
  tstats_start = 200.
/
&scalars
  nscal = 2, scal_form = 'skew'
  pr(1) = 7.0,  sbc_bot(1) = 'D', sval_bot(1) = 0.0, sbc_top(1) = 'D', sval_top(1) = 1.0, sinit(1) = 'noise'
  pr(2) = 70.0, sbc_bot(2) = 'D', sval_bot(2) = 0.0, sbc_top(2) = 'D', sval_top(2) = 1.0, sinit(2) = 'linear'
/
&buoyancy
  gravity = 0.0, 1.0                   ! towards increasing y (away from the ice)
  ri(1) =  0.01                        ! temperature: warm water is lighter
  ri(2) = -0.00057                     ! salinity: salty water is heavier
/
